{
  "Jwt": {
    "Issuer": "ResolveHub.Api",
    "Audience": "ResolveHub.Client",
    "AccessTokenExpirationMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "http://localhost:5173"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "Resend": {
    "FromEmail": "onboarding@resend.dev",
    "FromName": "ResolveHub"
  },
  "FileStorage": {
    "UploadRoot": "App_Data/TicketUploads",
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerTicket": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://resolvehub-api-e5cgb3exhrcmfnhe.germanywestcentral-01.azurewebsites.net/api/:path*"
    },
    {
      "source": "/profile-images/:path*",
      "destination": "https://resolvehub-api-e5cgb3exhrcmfnhe.germanywestcentral-01.azurewebsites.net/profile-images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
